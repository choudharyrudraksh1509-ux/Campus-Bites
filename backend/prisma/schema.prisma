generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int       @id @default(autoincrement())
  fullName     String
  email        String    @unique
  phone        String?
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  roles        UserRole[]
  ownedShops   Shop[]    @relation("OwnerShops")
  staffShops   ShopStaff[]
  orders       Order[]   @relation("CustomerOrders")
  reviews      Review[]
}

model Role {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  users UserRole[]
}

model UserRole {
  id     Int  @id @default(autoincrement())
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])
  
  @@unique([userId, roleId])
}

model Area {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  shops       Shop[]
}

model Shop {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  areaId    Int
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  owner     User     @relation("OwnerShops", fields: [ownerId], references: [id])
  area      Area     @relation(fields: [areaId], references: [id])
  
  staff     ShopStaff[]
  items     FoodItem[]
  orders    Order[]
  reviews   Review[]
}

model ShopStaff {
  id      Int  @id @default(autoincrement())
  shopId  Int
  staffId Int
  
  shop    Shop @relation(fields: [shopId], references: [id])
  staff   User @relation(fields: [staffId], references: [id])

  @@unique([shopId, staffId])
}

model Category {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  items FoodItem[]
}

model FoodItem {
  id          Int      @id @default(autoincrement())
  shopId      Int
  categoryId  Int
  name        String
  description String?
  price       Float
  isAvailable Boolean  @default(true)
  
  shop        Shop     @relation(fields: [shopId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
}

model Order {
  id          Int      @id @default(autoincrement())
  customerId  Int
  shopId      Int
  status      String   @default("PAYMENT_PENDING")
  totalAmount Float
  orderTime   DateTime @default(now())

  customer    User     @relation("CustomerOrders", fields: [customerId], references: [id])
  shop        Shop     @relation(fields: [shopId], references: [id])
  
  items       OrderItem[]
  payments    PaymentAttempt[]
  reviews     Review[]
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  itemId       Int
  quantity     Int
  priceAtOrder Float

  order        Order    @relation(fields: [orderId], references: [id])
  item         FoodItem @relation(fields: [itemId], references: [id])
}

model PaymentAttempt {
  id            Int      @id @default(autoincrement())
  orderId       Int
  amount        Float
  status        String   @default("PENDING")
  attemptTime   DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id])
}

model Review {
  id         Int      @id @default(autoincrement())
  orderId    Int      @unique
  customerId Int
  shopId     Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  order      Order    @relation(fields: [orderId], references: [id])
  customer   User     @relation(fields: [customerId], references: [id])
  shop       Shop     @relation(fields: [shopId], references: [id])
}
