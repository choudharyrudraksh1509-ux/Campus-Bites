# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication (Must be a secure random string, minimum 32 characters in production)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars

# Authoritative Database (PostgreSQL / Supabase via Prisma)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# CORS Configuration (Optional comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo Mode & Auto-Seeding (Strictly forbidden in production)
# When DEMO_MODE=true, in-memory reviews and demo fallbacks can be accessed in dev.
DEMO_MODE=false
AUTO_SEED=false
